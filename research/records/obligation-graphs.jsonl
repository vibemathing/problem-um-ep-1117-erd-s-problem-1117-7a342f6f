{"attempt_id": "attempt:um-ep-1117-erd-s-problem-1117-7a342f6f-source-fidelity-01", "created_at": "2026-09-06T08:00:00Z", "graph_id": "graph:um-ep-1117-erd-s-problem-1117-7a342f6f-v1", "obligations": [{"acceptance": {"allowed_candidate_kinds": ["proof", "counterexample", "formalization", "computation"], "required_capabilities": ["human_review", "statement_faithfulness"]}, "dependencies": ["obligation:um-ep-1117-erd-s-problem-1117-7a342f6f-statement-fidelity"], "kind": "root_claim", "obligation_id": "obligation:um-ep-1117-erd-s-problem-1117-7a342f6f-root", "source_refs": ["https://www.unsolvedmath.com/problems/EP-1117"], "statement": {"formal_declaration": null, "language": "en", "text": "Let $f(z)$ be an entire function which is not a monomial. Let $ u(r)$ count the number of $z$ with $\\lvert z\\rvert=r$ such that $\\lvert f(z)\\rvert=\\max_{\\lvert z\\rvert=r}\\lvert f(z)\\rvert$. (This is a finite quantity if $f$ is not a monomial.) Is it possible for $ \\limsup u(r)=\\infty? $ Is it possible for $ \\liminf u(r)=\\infty? $"}, "statement_sha256": "11b36b72de9d9cd40238c750c2265fde2869dd7997107444db087f93458c07ba"}, {"acceptance": {"allowed_candidate_kinds": ["proof"], "required_capabilities": ["human_review", "statement_faithfulness"]}, "dependencies": [], "kind": "definition", "obligation_id": "obligation:um-ep-1117-erd-s-problem-1117-7a342f6f-statement-fidelity", "source_refs": ["https://www.unsolvedmath.com/problems/EP-1117"], "statement": {"formal_declaration": null, "language": "en", "text": "Verify against the cited source that the frozen statement is complete, current, untruncated, attribution-correct, and unambiguous enough for mathematical research; record any definition or quantifier gap without silently editing the contract."}, "statement_sha256": "65f0b3d574bd6d837403149dab6434c0f571709f7eb5bb066c7e8774bad13f34"}], "problem_contract_sha256": "54e83a71a49834b1985cf7a7bbf3b71e6aa50e49756dee6c0a402ac3eaea28b4", "problem_id": "problem:um-ep-1117-erd-s-probl